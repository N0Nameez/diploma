# ── Supabase (Cloud or Local) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_KEY=sb_secret_YOUR_KEY

# ── Backend Server ──
VITE_API_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# ── Redis (for ARQ Queue) ──
REDIS_URL=redis://localhost:6379

# ── Generation (ML Pipeline) ──
# Path to Python executable with ML dependencies (WSL/Ubuntu or local)
GENERATION_PYTHON=python
