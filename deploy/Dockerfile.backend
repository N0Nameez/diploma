# /deploy/Dockerfile.backend
# Облегченная версия только для API
FROM python:3.10-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgl1 libglib2.0-0 libgles2 libegl1 \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем Torch CPU для моделей модерации (Toxicity / NSFW), чтобы не раздувать образ CUDA
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Устанавливаем только базовые зависимости для работы API и БД + модерации
RUN echo "fastapi\nuvicorn\npython-multipart\npydantic\nsupabase\nhttpx\nPyJWT\nslowapi\npsycopg2-binary\narq\nredis\npython-dotenv\nPillow\nyookassa\ntransformers\nopencv-python-headless\nmediapipe\nnumpy\npython-dateutil\ntrimesh" > requirements_api.txt
RUN pip install --no-cache-dir -r requirements_api.txt

COPY backend/ .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
